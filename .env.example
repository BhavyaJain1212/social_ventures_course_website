# Flask Configuration
SECRET_KEY=your-secret-key-here
FLASK_ENV=development
FLASK_DEBUG=1

# Database
DATABASE_URI=database/app.db

# Image Generation API (future integration)
# Supported: openai_dalle, stability_ai, mock
IMAGE_GEN_PROVIDER=mock
IMAGE_GEN_API_KEY=your-api-key-here

# Pinterest API (future integration)
PINTEREST_API_KEY=your-pinterest-api-key-here
PINTEREST_API_SECRET=your-pinterest-api-secret-here
